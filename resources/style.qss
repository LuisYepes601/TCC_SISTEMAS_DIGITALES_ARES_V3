/* =====================================================================
   Ares v3.0 — Tema Claro
   Paleta: Slate-50 / Blue-600 / Teal-600
   ===================================================================== */

* { box-sizing: border-box; }

QMainWindow, QWidget {
    background-color: #f1f5f9;
    color: #0f172a;
    font-family: "Segoe UI", "SF Pro Text", system-ui, sans-serif;
    font-size: 9pt;
}

QWidget#TopStatusBar { background-color: #ffffff; border-bottom: 1px solid #e2e8f0; }
QLabel#StatusBarLabel { color: #64748b; font-size: 8.5pt; }
#StatusSeparator { background-color: #e2e8f0; }

QWidget#Sidebar { background-color: #f8fafc; border-right: 1px solid #e2e8f0; }
#SidebarSeparator { background-color: #e2e8f0; }

QLabel#SidebarTitle {
    color: #0369a1;
    font-size: 17pt;
    font-weight: 700;
    letter-spacing: 3px;
}
QLabel#SidebarSubtitle { color: #94a3b8; font-size: 8pt; }
QLabel#SidebarUptime   { color: #94a3b8; font-size: 8pt; }

QPushButton#NavButton {
    background-color: transparent;
    color: #475569;
    border: none;
    border-radius: 8px;
    padding: 10px 14px;
    text-align: left;
    font-size: 9pt;
}
QPushButton#NavButton:hover { background-color: #e2e8f0; color: #0f172a; }
QPushButton#NavButton:checked {
    background-color: #dbeafe;
    color: #0369a1;
    font-weight: 700;
    border-left: 3px solid #0369a1;
    padding-left: 11px;
}

QStackedWidget#ContentStack { background-color: #f1f5f9; }

QMenuBar { background-color: #ffffff; color: #475569; border-bottom: 1px solid #e2e8f0; }
QMenuBar::item:selected { background-color: #f1f5f9; border-radius: 4px; }
QMenu { background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 4px; }
QMenu::item { padding: 7px 20px; border-radius: 5px; }
QMenu::item:selected { background-color: #dbeafe; color: #0369a1; }
QMenu::separator { height: 1px; background-color: #e2e8f0; margin: 4px 0; }

QPushButton {
    background-color: #0369a1;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 14px;
    min-width: 70px;
    font-weight: 500;
}
QPushButton:hover    { background-color: #0284c7; }
QPushButton:pressed  { background-color: #0c4a6e; }
QPushButton:disabled { background-color: #cbd5e1; color: #94a3b8; }
QPushButton:checked  { background-color: #0284c7; }

QPushButton#DangerButton {
    background-color: #fef2f2;
    border: 1px solid #fca5a5;
    color: #dc2626;
}
QPushButton#DangerButton:hover { background-color: #dc2626; color: #fff; }

QPushButton#ApplyButton {
    background-color: #dcfce7;
    color: #15803d;
    border: 1px solid #22c55e;
    border-radius: 6px;
    padding: 8px;
    font-weight: 600;
}
QPushButton#ApplyButton:hover { background-color: #16a34a; color: #fff; }

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 10px;
    color: #0f172a;
    selection-background-color: #0369a1;
}
QLineEdit:focus { border-color: #0369a1; }

QTableWidget, QTableView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    gridline-color: #f1f5f9;
    alternate-background-color: #f8fafc;
    selection-background-color: #dbeafe;
    selection-color: #0369a1;
}
QTableWidget::item, QTableView::item {
    padding: 3px 6px;
    border: none;
    border-bottom: 1px solid #f1f5f9;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: #dbeafe;
    color: #0369a1;
}
QHeaderView::section {
    background-color: #f8fafc;
    color: #64748b;
    padding: 7px 6px;
    border: none;
    border-right: 1px solid #e2e8f0;
    border-bottom: 2px solid #0369a1;
    font-weight: 700;
    font-size: 8pt;
    text-transform: uppercase;
}
QHeaderView::section:hover { background-color: #f1f5f9; color: #0369a1; }

QGroupBox {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
    color: #64748b;
    font-weight: 600;
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 6px; color: #94a3b8; }
QGroupBox#ThresholdGroup { border-color: #cbd5e1; }

QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 4px 8px;
    color: #0f172a;
    min-width: 80px;
}
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #0369a1; }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    selection-background-color: #dbeafe;
    color: #0f172a;
    border-radius: 6px;
}

QScrollBar:vertical { background: #f1f5f9; width: 8px; border-radius: 4px; }
QScrollBar::handle:vertical { background: #cbd5e1; border-radius: 4px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #f1f5f9; height: 8px; border-radius: 4px; }
QScrollBar::handle:horizontal { background: #cbd5e1; border-radius: 4px; min-width: 24px; }
QScrollBar::handle:horizontal:hover { background: #94a3b8; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QLabel { color: #0f172a; }
QLabel#PanelTitle   { color: #0f172a; font-size: 12pt; font-weight: 700; }
QLabel#AlertCount   { color: #94a3b8; font-size: 9pt; }
QLabel#ProcessCount { color: #94a3b8; font-size: 8.5pt; }
QLabel#EmptyAlertsLabel { color: #15803d; font-size: 10pt; padding: 30px; }

QProgressBar {
    background-color: #e2e8f0;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    text-align: center;
    color: #0f172a;
    font-size: 8pt;
    font-weight: 700;
}
QProgressBar::chunk { background: #0369a1; border-radius: 5px; }

QProgressBar#HealthBar {
    height: 16px;
    background-color: #e2e8f0;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
}
QProgressBar#HealthBar::chunk { border-radius: 5px; }

QLabel#HealthTitle { color: #475569; font-size: 9pt; font-weight: 700; }
QLabel#HealthDesc  { color: #94a3b8; font-size: 8pt; }

QLabel#CoreLabel { color: #94a3b8; font-size: 7.5pt; }
QProgressBar#CoreBar {
    background-color: #e2e8f0;
    border: none;
    border-radius: 3px;
    height: 14px;
}
QProgressBar#CoreBar::chunk { background: #0369a1; border-radius: 3px; }

QFrame[frameShape="5"], QFrame[frameShape="4"] {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

QDialog    { background-color: #f8fafc; }
QMessageBox { background-color: #ffffff; }

QSplitter::handle { background-color: #e2e8f0; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical   { height: 2px; }
QSplitter::handle:hover { background-color: #0369a1; }

QMenu#ContextMenu {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 6px;
}
QMenu#ContextMenu::item { padding: 7px 20px; border-radius: 5px; }
QMenu#ContextMenu::item:selected { background-color: #dbeafe; color: #0369a1; }
