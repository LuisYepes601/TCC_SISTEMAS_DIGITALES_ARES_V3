/* =====================================================================
   Ares v3.0 — Tema Oscuro Premium
   Paleta: Slate-950 / Cyan-400 / Emerald-400
   ===================================================================== */

* { box-sizing: border-box; }

QMainWindow, QWidget {
    background-color: #0f172a;
    color: #e2e8f0;
    font-family: "Segoe UI", "SF Pro Text", system-ui, sans-serif;
    font-size: 9pt;
}

/* ── Barra de estado ───────────────────────────────────────────────── */
QWidget#TopStatusBar {
    background-color: #0a1628;
    border-bottom: 1px solid #1e3a5f;
}
QLabel#StatusBarLabel { color: #94a3b8; font-size: 8.5pt; }
#StatusSeparator { background-color: #1e293b; }

/* ── Sidebar ───────────────────────────────────────────────────────── */
QWidget#Sidebar { background-color: #080f1e; }
#SidebarSeparator { background-color: #1e293b; }

QLabel#SidebarTitle {
    color: #22d3ee;
    font-size: 17pt;
    font-weight: 700;
    letter-spacing: 3px;
    padding: 4px 0;
}
QLabel#SidebarSubtitle { color: #334155; font-size: 8pt; }
QLabel#SidebarUptime   { color: #475569; font-size: 8pt; }

QPushButton#NavButton {
    background-color: transparent;
    color: #64748b;
    border: none;
    border-radius: 8px;
    padding: 10px 14px;
    text-align: left;
    font-size: 9pt;
}
QPushButton#NavButton:hover { background-color: #1e293b; color: #e2e8f0; }
QPushButton#NavButton:checked {
    background-color: #0e3a52;
    color: #22d3ee;
    font-weight: 700;
    border-left: 3px solid #22d3ee;
    padding-left: 11px;
}

/* ── Stack ─────────────────────────────────────────────────────────── */
QStackedWidget#ContentStack { background-color: #0f172a; }

/* ── Menú ──────────────────────────────────────────────────────────── */
QMenuBar {
    background-color: #080f1e;
    color: #64748b;
    border-bottom: 1px solid #1e293b;
    padding: 2px;
}
QMenuBar::item:selected { background-color: #1e293b; color: #e2e8f0; border-radius: 4px; }
QMenu {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item { padding: 7px 20px; border-radius: 5px; }
QMenu::item:selected { background-color: #0e3a52; color: #22d3ee; }
QMenu::separator { height: 1px; background-color: #334155; margin: 4px 0; }

/* ── Botones ───────────────────────────────────────────────────────── */
QPushButton {
    background-color: #164e63;
    color: #e2e8f0;
    border: 1px solid #0e7490;
    border-radius: 6px;
    padding: 6px 14px;
    min-width: 70px;
    font-weight: 500;
}
QPushButton:hover    { background-color: #0e7490; color: #fff; }
QPushButton:pressed  { background-color: #0891b2; }
QPushButton:disabled { background-color: #1e293b; color: #475569; border-color: #334155; }
QPushButton:checked  { background-color: #0e7490; color: #fff; }

QPushButton#DangerButton {
    background-color: #450a0a;
    border-color: #991b1b;
    color: #fca5a5;
}
QPushButton#DangerButton:hover { background-color: #7f1d1d; color: #fff; }

QPushButton#ApplyButton {
    background-color: #14532d;
    color: #86efac;
    border: 1px solid #22c55e;
    border-radius: 6px;
    padding: 8px;
    font-weight: 600;
}
QPushButton#ApplyButton:hover { background-color: #166534; color: #fff; }

/* ── Inputs ────────────────────────────────────────────────────────── */
QLineEdit {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
    color: #e2e8f0;
    selection-background-color: #0e7490;
}
QLineEdit:focus { border-color: #22d3ee; }

/* ── Tablas ────────────────────────────────────────────────────────── */
QTableWidget, QTableView {
    background-color: #0d1117;
    border: 1px solid #1e293b;
    border-radius: 8px;
    gridline-color: #1a2235;
    alternate-background-color: #0a0f1e;
    selection-background-color: #0e3a52;
    selection-color: #22d3ee;
    show-decoration-selected: 1;
}
QTableWidget::item, QTableView::item {
    padding: 3px 6px;
    border: none;
    border-bottom: 1px solid #131c2e;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: #0e3a52;
    color: #22d3ee;
}
QHeaderView::section {
    background-color: #080f1e;
    color: #475569;
    padding: 7px 6px;
    border: none;
    border-right: 1px solid #1e293b;
    border-bottom: 2px solid #22d3ee;
    font-weight: 700;
    font-size: 8pt;
    text-transform: uppercase;
    letter-spacing: 1px;
}
QHeaderView::section:hover { background-color: #0e1a30; color: #94a3b8; }

/* ── GroupBox ──────────────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #1e293b;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
    color: #94a3b8;
    font-weight: 600;
    font-size: 9pt;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #64748b;
}
QGroupBox#ThresholdGroup { border-color: #334155; }

/* ── ComboBox / SpinBox ────────────────────────────────────────────── */
QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px 8px;
    color: #e2e8f0;
    min-width: 80px;
}
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #22d3ee; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background-color: #1e293b;
    border: 1px solid #334155;
    selection-background-color: #0e3a52;
    color: #e2e8f0;
    border-radius: 6px;
}

/* ── Scrollbars ────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #080f1e;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #1e3a5f;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #334155; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: #080f1e;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #1e3a5f;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: #334155; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── Labels ────────────────────────────────────────────────────────── */
QLabel { color: #e2e8f0; }
QLabel#PanelTitle { color: #e2e8f0; font-size: 12pt; font-weight: 700; }
QLabel#AlertCount { color: #94a3b8; font-size: 9pt; }
QLabel#ProcessCount { color: #475569; font-size: 8.5pt; }
QLabel#EmptyAlertsLabel { color: #22c55e; font-size: 10pt; padding: 30px; }

/* ── ProgressBar ───────────────────────────────────────────────────── */
QProgressBar {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    text-align: center;
    color: #e2e8f0;
    font-size: 8pt;
    font-weight: 700;
}
QProgressBar::chunk { background: #22d3ee; border-radius: 5px; }

QProgressBar#HealthBar {
    height: 16px;
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
}
QProgressBar#HealthBar::chunk { border-radius: 5px; }

QLabel#HealthTitle { color: #94a3b8; font-size: 9pt; font-weight: 700; }
QLabel#HealthDesc  { color: #64748b; font-size: 8pt; }

/* Núcleos CPU */
QLabel#CoreLabel { color: #64748b; font-size: 7.5pt; }
QProgressBar#CoreBar {
    background-color: #1e293b;
    border: none;
    border-radius: 3px;
    height: 14px;
}
QProgressBar#CoreBar::chunk { background: #22d3ee; border-radius: 3px; }

/* ── Paneles de sistema ────────────────────────────────────────────── */
QFrame[frameShape="5"], QFrame[frameShape="4"] {
    background-color: #0d1117;
    border: 1px solid #1e293b;
    border-radius: 8px;
}

/* ── Diálogos ──────────────────────────────────────────────────────── */
QDialog    { background-color: #0f172a; }
QMessageBox { background-color: #0f172a; }
QDialogButtonBox QPushButton { min-width: 80px; }

/* ── Menú contextual ───────────────────────────────────────────────── */
QMenu#ContextMenu {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 6px;
}
QMenu#ContextMenu::item { padding: 7px 20px; border-radius: 5px; }
QMenu#ContextMenu::item:selected { background-color: #0e3a52; color: #22d3ee; }

/* ── Splitter ──────────────────────────────────────────────────────── */
QSplitter::handle { background-color: #1e293b; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical   { height: 2px; }
QSplitter::handle:hover { background-color: #22d3ee; }
